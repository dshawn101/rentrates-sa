# Supabase account configuration (public browser values)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI keys are entered by each author in Settings and held in page memory.
# Never place provider secret keys in VITE_ variables or commit them to git.

# PayPal: SERVER ONLY. Start with sandbox; enable real checkout only after acceptance testing.
# Never use a VITE_ prefix on these secrets.
PAYPAL_CHECKOUT_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_LITE_PLAN_ID=
PAYPAL_WEBHOOK_ID=
APP_ORIGIN=https://www.publestudio.com
# Supabase secret key (sb_secret_...) or legacy service_role key; server only.
SUPABASE_SECRET_KEY=
